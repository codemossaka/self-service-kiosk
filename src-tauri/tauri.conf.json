{
  "productName": "Библиотека",
  "version": "1.0.0",
  "identifier": "com.branham.messages",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn vite",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Russian"],
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "startMenuFolder": "Branham"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Библиотека",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": true,
        "decorations": true,
        "closable": true,
        "minimizable": true,
        "maximizable": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}

